# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Имена совпадают с другими проектами — один .env подходит везде.

# === Polymarket ===
# Приватный ключ кошелька, которым логинишься на polymarket.com
# (MetaMask -> три точки у аккаунта -> Account details -> Show private key)
POLY_PRIVATE_KEY=
# Proxy-адрес аккаунта Polymarket (адрес с деньгами, из URL профиля — НЕ адрес MetaMask)
POLY_FUNDER=
# Тип подписи: 3 = POLY_1271 (депозитный кошелёк), 2 = MetaMask/Safe,
# 1 = email/Magic, 0 = EOA. Проверить можно так: `python main.py check` читает
# баланс именно этим типом — если видно 0.00$ при непустом счёте, тип не тот.
POLY_SIGNATURE_TYPE=3

# API-креды CLOB. Можно оставить пустыми — выводятся из приватного ключа
# детерминированно, включая ключи для WebSocket-канала своих сделок.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# === Telegram ===
TG_TOKEN=
# Белый список user_id через запятую. Уведомления уходят первому в списке.
TG_ALLOWED_USER_IDS=
