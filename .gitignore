# В репозитории — только то, что нужно боевому боту. Исследование, отчёты и
# рабочее состояние живут локально: чтобы развернуть и запустить, они не нужны.
#
# Комментарии только на отдельных строках: в конце строки с шаблоном git их не
# распознаёт и молча считает частью самого шаблона.

# --- секреты и рабочее состояние ------------------------------------------
.env
# settings.toml — личные переопределения параметров, у каждой машины свои;
# пример со всеми ключами и пояснениями — settings.example.toml, он в git.
settings.toml
# data/ — bot.db, журнал сделок; у каждой машины свой
data/
logs/
*.db

# --- исследование ----------------------------------------------------------
# Один файл — исключение: боевой код импортирует его напрямую (app/features.py
# кладёт research/ в sys.path), чтобы минутки грузились тем же кодом, что и
# раньше. Расчёт признаков и модель теперь целиком в poly_hourly_kit/.
research/*
!research/btc_data.py
# графики к старым локальным отчётам исследования
reports/
# план до реализации, его заменил README
PLAN.md

# --- модели (poly_hourly_kit*/) ---------------------------------------------
# По комплекту на монету: poly_hourly_kit/ — BTC, poly_hourly_kit_eth/ — ETH.
# Какой из них берётся, решает COIN в config.py; в репозитории лежат оба, чтобы
# одно и то же развёртывание годилось под любую монету.
#
# kit/, model/, fixtures/, train/, passport.json — трекаются целиком, это и есть
# боевая модель (см. README.md внутри комплекта). Не трекаются только тяжёлые и
# генерируемые вещи: кэш минуток для переобучения и черновики/бэкапы замены.
# Без этих строк первый же `main.py retrain` утащит в репозиторий ~180 МБ parquet.
poly_hourly_kit/data/
poly_hourly_kit/model_new/
poly_hourly_kit/model_backup/
poly_hourly_kit_eth/data/
poly_hourly_kit_eth/model_new/
poly_hourly_kit_eth/model_backup/

# --- мусор -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.DS_Store
