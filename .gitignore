# В репозитории — только то, что нужно боевому боту. Исследование, отчёты и
# рабочее состояние живут локально: чтобы развернуть и запустить, они не нужны.
#
# Комментарии только на отдельных строках: в конце строки с шаблоном git их не
# распознаёт и молча считает частью самого шаблона.

# --- секреты и рабочее состояние ------------------------------------------
.env
# data/ — bot.db, журнал сделок; у каждой машины свой
data/
logs/
*.db

# --- исследование ----------------------------------------------------------
# Три файла — исключения: боевой код импортирует их напрямую (app/features.py
# кладёт research/ в sys.path), чтобы признаки считались тем же кодом, что и
# при обучении. Без них бот не стартует.
research/*
!research/features.py
!research/btc_data.py
!research/btc_features.py
# графики к research/REPORT.md
reports/
# план до реализации, его заменил README
PLAN.md

# --- модель ----------------------------------------------------------------
# model.joblib нужен в бою: app/model.py грузит его при старте, весит 5 КБ.
# model_cutoff* — черновики перебора обрезки, это уже исследование.
models/*
!models/model.joblib

# --- мусор -----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.DS_Store
